<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DomeMQ.Inspector.Views.ChannelsView">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="title" Text="Channels" Margin="0,0,0,12"/>
    <Border Classes="card">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="150,70,90,90,130,150,120,*" Margin="4,0,4,8">
          <TextBlock Classes="muted" Text="Name"/>
          <TextBlock Grid.Column="1" Classes="muted" Text="Type"/>
          <TextBlock Grid.Column="2" Classes="muted" Text="Owner"/>
          <TextBlock Grid.Column="3" Classes="muted" Text="Count"/>
          <TextBlock Grid.Column="4" Classes="muted" Text="Bytes"/>
          <TextBlock Grid.Column="5" Classes="muted" Text="Fill"/>
          <TextBlock Grid.Column="6" Classes="muted" Text="Policy"/>
          <TextBlock Grid.Column="7" Classes="muted" Text="Drop / clear"/>
        </Grid>
        <ListBox ItemsSource="{Binding Channels}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="150,70,90,90,130,150,120,*" Margin="0,6">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Kind}"/>
                <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Owner}"/>
                <TextBlock Grid.Column="3" Text="{Binding Count}"/>
                <TextBlock Grid.Column="4" Text="{Binding Bytes}"/>
                <ProgressBar Grid.Column="5" Minimum="0" Maximum="100" Value="{Binding FillPercent}" Foreground="{Binding FillBrush}" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="120" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="6" Text="{Binding Policy}"/>
                <TextBlock Grid.Column="7" Text="{Binding Dropped}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
