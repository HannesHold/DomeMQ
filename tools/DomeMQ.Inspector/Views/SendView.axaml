<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="using:ScottPlot.Avalonia"
             x:Class="DomeMQ.Inspector.Views.SendView">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
      <TextBlock Classes="title" Text="Send / Stress"/>
      <Grid ColumnDefinitions="*,120,120,100,100" ColumnSpacing="8">
        <TextBox PlaceholderText="Target channel" Text="{Binding TargetChannel}"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding PayloadModes}" SelectedItem="{Binding PayloadMode}"/>
        <NumericUpDown Grid.Column="2" Minimum="1" Maximum="10000000" Value="{Binding SendCount}" PlaceholderText="N"/>
        <NumericUpDown Grid.Column="3" Minimum="1" Maximum="64" Value="{Binding Parallelism}" PlaceholderText="Parallel"/>
        <NumericUpDown Grid.Column="4" Minimum="0" Maximum="60000" Value="{Binding IntervalMs}" PlaceholderText="Interval ms"/>
      </Grid>
      <TextBox AcceptsReturn="True" Height="120" Text="{Binding Payload}" PlaceholderText="Payload"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="Start" Command="{Binding StartStressCommand}"/>
        <Button Classes="quiet" Content="Stop" Command="{Binding StopStressCommand}"/>
      </StackPanel>
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Foreground="#6CB6FF"/>
      <TextBlock Classes="mono" Text="{Binding StressResult}" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Classes="card">
      <sp:AvaPlot x:Name="Plot"/>
    </Border>
  </DockPanel>
</UserControl>
