<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DomeMQ.Inspector.Views.ConnectView">
  <ScrollViewer>
    <StackPanel Spacing="14" MaxWidth="920">
      <TextBlock Classes="title" Text="Connect"/>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="Endpoint"/>
          <Grid ColumnDefinitions="140,160,120,*" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding Transports}" SelectedItem="{Binding Transport}"/>
            <TextBox Grid.Column="1" PlaceholderText="Host" Text="{Binding Host}"/>
            <NumericUpDown Grid.Column="2" Minimum="0" Maximum="65535" Value="{Binding Port}"/>
            <TextBox Grid.Column="3" PlaceholderText="Unix socket path" Text="{Binding SocketPath}"/>
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <TextBox PlaceholderText="Client name" Text="{Binding ClientName}"/>
            <TextBox Grid.Column="1" PlaceholderText="Auth token" Text="{Binding AuthToken}"/>
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="TLS"/>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox Content="Enable TLS" IsChecked="{Binding TlsEnabled}"/>
            <CheckBox Content="Allow untrusted server certificate" IsChecked="{Binding AllowUntrusted}"/>
          </StackPanel>
          <TextBox PlaceholderText="Target host (SNI)" Text="{Binding TargetHost}"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <TextBox PlaceholderText="Client PFX path" Text="{Binding PfxPath}"/>
            <TextBox Grid.Column="1" PlaceholderText="PFX password" Text="{Binding PfxPassword}" PasswordChar="•"/>
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <TextBox PlaceholderText="Client certificate PEM" Text="{Binding CertificatePath}"/>
            <TextBox Grid.Column="1" PlaceholderText="Client key PEM" Text="{Binding KeyPath}"/>
          </Grid>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="Connect" Command="{Binding ConnectCommand}"/>
        <Button Classes="quiet" Content="Disconnect" Command="{Binding DisconnectCommand}"/>
        <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextWrapping="Wrap"/>
      </StackPanel>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="Channel"/>
          <Grid ColumnDefinitions="*,140" ColumnSpacing="8">
            <TextBox PlaceholderText="Name" Text="{Binding ChannelName}"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding ChannelTypes}" SelectedItem="{Binding ChannelType}"/>
          </Grid>
          <Grid ColumnDefinitions="*,*,*,160" ColumnSpacing="8">
            <TextBox PlaceholderText="Max messages" Text="{Binding MaxMessages}"/>
            <TextBox Grid.Column="1" PlaceholderText="Max payload" Text="{Binding MaxPayload}"/>
            <TextBox Grid.Column="2" PlaceholderText="Max bytes" Text="{Binding MaxBytes}"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding Policies}" SelectedItem="{Binding FullPolicy}"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="Create" Command="{Binding CreateChannelCommand}"/>
            <Button Classes="quiet" Content="Delete" Command="{Binding DeleteChannelCommand}"/>
          </StackPanel>
          <TextBlock Classes="mono" Text="{Binding ChannelStatus}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
