<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DomeMQ.Inspector.Views.ClientsView">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="title" Text="Clients" Margin="0,0,0,12"/>
    <Border Classes="card">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="200,80,180,90,80,150,*" Margin="4,0,4,8">
          <TextBlock Classes="muted" Text="Endpoint"/>
          <TextBlock Grid.Column="1" Classes="muted" Text="Connected"/>
          <TextBlock Grid.Column="2" Classes="muted" Text="Certificate"/>
          <TextBlock Grid.Column="3" Classes="muted" Text="Key"/>
          <TextBlock Grid.Column="4" Classes="muted" Text="State"/>
          <TextBlock Grid.Column="5" Classes="muted" Text="Messages"/>
          <TextBlock Grid.Column="6" Classes="muted" Text="Bytes"/>
        </Grid>
        <ListBox ItemsSource="{Binding Clients}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="200,80,180,90,80,150,*" Margin="0,4">
                <TextBlock Classes="mono" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding ConnectedAt}"/>
                <TextBlock Grid.Column="2" Text="{Binding Certificate}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding KeyId}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="4" Text="{Binding State}"/>
                <TextBlock Grid.Column="5" Text="{Binding Messages}"/>
                <TextBlock Grid.Column="6" Text="{Binding Bytes}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
