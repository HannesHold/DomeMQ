{
  // DomeMQ broker configuration.
  // Alternate file name: domemq.json (same schema), next to the executable or under /config.
  // Override any value with environment variables: DomeMQ__Limits__MaxClients=2048
  // Or pass --config /path/to/domemq.json (also DOMEMQ_CONFIG).
  // Later sources win: executable appsettings.json, executable domemq.json,
  // /config/appsettings.json, /config/domemq.json, --config, environment variables, command line.
  // IP access lists are re-read about every 5 seconds. Other settings apply on restart.
  // Null listener fields inherit the matching top-level section.
  "DomeMQ": {
    "ServerName": "DomeMQ",

    "Listeners": [
      {
        "Name": "tcp",
        "Transport": "Tcp",
        "Enabled": true,
        "Host": "0.0.0.0",
        "Port": 5071,
        // Null inherits Limits.MaxPayloadSize (16 MiB). Set a smaller ceiling for this listener only.
        "MaxPayloadSize": null,
        // Null inherits the Tcp section.
        "NoDelay": null,
        "KeepAlive": null,
        "KeepAliveTimeSeconds": null,
        "KeepAliveIntervalSeconds": null,
        "ReceiveBufferSize": null,
        "SendBufferSize": null,
        "Backlog": null,
        // Null leaves the operating system linger default.
        "LingerSeconds": null,
        // Null inherits the top-level Tls section, including KeyId. TLS is TCP-only.
        // A value replaces the whole section. Example: "Tls": { "Enabled": true, "KeyId": "primary" }
        "Tls": null,
        // Null inherits the top-level IpAccess section. A value replaces it for this listener only.
        "IpAccess": null
      },
      {
        // Turn Enabled on to listen on a Unix domain socket. Not subject to IP access rules.
        // On Windows use a filesystem path such as C:\\temp\\domemq.sock.
        "Name": "unix",
        "Transport": "UnixSocket",
        "Enabled": false,
        "Path": "/tmp/domemq.sock",
        // Null inherits Unix.DeleteStaleSocket and Unix.Permissions.
        "DeleteStaleSocket": null,
        "Permissions": null
      }
      // Reserved, not implemented yet:
      // { "Name": "udp", "Transport": "Udp", "Enabled": false, "Host": "0.0.0.0", "Port": 5073 }
      // { "Name": "kcp", "Transport": "Kcp", "Enabled": false, "Host": "0.0.0.0", "Port": 5074 }
    ],

    "Limits": {
      "MaxClients": 1024,
      "MaxChannelsPerClient": 1024,
      "MaxChannels": 10000,
      "MaxPayloadSize": 16777216,
      "MaxMessagesPerChannel": 100000,
      // Null means a channel has no byte cap of its own. The server-wide cap still applies.
      "MaxBytesPerChannel": null,
      "MaxQueuedBytes": 1073741824,
      "MaxMessagesPerClient": 1000000,
      // Reject, DiscardNewest, DiscardOldest (alias DropOldest), or ClearAll.
      "FullBehavior": "Reject",
      "WarningPercent": 80
    },

    "Tcp": {
      // true disables Nagle so small IPC messages are not delayed.
      "NoDelay": true,
      "KeepAlive": true,
      "KeepAliveTimeSeconds": 60,
      "KeepAliveIntervalSeconds": 10,
      "ReceiveBufferSize": 262144,
      "SendBufferSize": 262144,
      "Backlog": 512,
      "LingerSeconds": null
    },

    // Named TLS identities. Each PrivateKey, Certificate, and optional Password is
    // { "Env": "VAR_NAME" } or { "File": "/path" }. Inline PEM is rejected.
    // Env values are PEM text or base64 PKCS#12. File points at a PEM or PFX file.
    // "Keys": [
    //   {
    //     "Id": "primary",
    //     "PrivateKey": { "File": "/etc/domemq/server.key" },
    //     "Certificate": { "File": "/etc/domemq/server.crt" },
    //     "Password": { "Env": "DOMEMQ_KEY_PASSWORD" }
    //   }
    // ]
    "Keys": [],

    "Tls": {
      "Enabled": false,
      // Omit KeyId only when Keys contains exactly one entry; that key is the default.
      "KeyId": null,
      "RequireClientCertificate": false,
      "AllowUntrustedCertificates": false,
      // Trusted client CAs or pinned public certificates. Same Env/File shape as Keys.
      "ClientAuthorities": [],
      "Protocols": [ "Tls12", "Tls13" ]
    },

    "Timeouts": {
      "HandshakeTimeout": "00:00:15",
      // Zero disables the idle timeout.
      "IdleTimeout": "00:05:00",
      // Zero waits indefinitely for the rest of a frame or for a write.
      "ReadTimeout": "00:02:00",
      "WriteTimeout": "00:02:00",
      // How often a quiet connection is pinged. Zero disables server pings. Must be shorter than IdleTimeout.
      "HeartbeatInterval": "00:00:30"
    },

    "Authentication": {
      // None or SharedKey. SharedKey requires at least one token.
      "Mode": "None",
      "Tokens": []
    },

    "Unix": {
      "DeleteStaleSocket": true,
      // Octal mode string. Null keeps the platform default. Ignored on Windows.
      "Permissions": null
    },

    "Channels": {
      // Used when CreateChannel sends channel type 0.
      "DefaultType": "Queue",
      // Null or zero means messages never expire.
      "DefaultMessageTtl": null,
      // How long a channel lives after its owner disconnects. Zero deletes it immediately.
      "OrphanChannelTtl": "00:05:00",
      // Background scan for orphaned channels and expired messages. Required when OrphanChannelTtl is positive.
      "CleanupInterval": "00:00:30",
      // Optional named limits. Effective numeric limits are the minimum of the global, this override, and the create request.
      // "Overrides": [
      //   { "Name": "orders", "MaxMessages": 1000, "MaxBytes": 1048576, "FullBehavior": "DiscardOldest" }
      // ]
      "Overrides": []
    },

    "Health": {
      "Enabled": false,
      // Loopback by default so a health port is not exposed accidentally.
      "Host": "127.0.0.1",
      "Port": 5072,
      "Path": "/health"
    },

    "IpAccess": {
      // While false, every IP is accepted and Entries are only checked for syntax.
      "Enabled": false,
      // Allowlist (alias Whitelist) or Blocklist.
      "Mode": "Allowlist",
      // When true, 127.0.0.0/8 and ::1 are allowed even if the list would exclude them.
      // Ignored while Enabled is false. Unix sockets are never filtered by these rules.
      "AllowLoopback": true,
      "Entries": [
        "127.0.0.1",
        "::1/128"
      ]
    },

    "Logging": {
      "MinimumLevel": "Information",
      "Console": true,
      "File": false,
      "FilePath": "domemq.log"
    }
  }
}
